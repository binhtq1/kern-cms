{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "binhtq1/kern-cms",
    "type": "project",
    "description": "Kern CMS on Laravel 13",
    "homepage": "https://github.com/binhtq1/kern-cms",
    "license": "MIT",
    "authors": [
        {
            "name": "Binh Tran",
            "email": "quocbinhkrb@gmail.com",
            "homepage": "https://github.com/binhtq1",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/binhtq1/kern-cms/issues",
        "source": "https://github.com/binhtq1/kern-cms",
        "email": "quocbinhkrb@gmail.com"
    },
    "keywords": [
        "laravel",
        "framework"
    ],
    "require": {
        "binhtq1/kern-core": "^0.4.0",
        "google/analytics-data": "^0.23 || ^0.24",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.0",
        "laravel/socialite": "^5.0",
        "laravel/tinker": "^3.0",
        "php": "^8.4",
        "phpseclib/bcmath_compat": "^2.0",
        "predis/predis": "^3.0",
        "symfony/var-exporter": "^7.4 || ^8.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "*",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan cms:publish:assets --ansi",
            "@php -r \"echo PHP_EOL, 'Kern CMS is ready. Run: cd '.basename(getcwd()).' && php artisan serve', PHP_EOL, 'Open your website to finish setup in the installation wizard.', PHP_EOL;\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

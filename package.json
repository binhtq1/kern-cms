{
    "author": {
        "name": "Binh Tran",
        "email": "quocbinhkrb@gmail.com",
        "url": "https://github.com/binhtq1"
    },
    "private": true,
    "workspaces": {
        "packages": [
            "platform/core/*",
            "platform/packages/*",
            "platform/plugins/*",
            "platform/themes/*"
        ]
    },
    "scripts": {
        "dev": "npm run dev:admin",
        "build": "npm run build:all",
        "build:all": "npm run build:admin && npm run build:public",
        "format": "npx prettier platform/**/resources/js/**/*.{js,vue} platform/**/resources/sass/*.scss platform/**/resources/views/**/*.blade.php platform/themes/*/{layouts,partials,views,widgets}/**/*.blade.php platform/themes/*/assets/**/*.{js,scss} --write",
        "dev:admin": "vite --config vite.config.ts",
        "build:admin": "vite build --config vite.config.ts",
        "dev:theme": "node scripts/theme-vite.mjs dev",
        "build:theme": "node scripts/theme-vite.mjs build",
        "build:themes": "node scripts/theme-vite.mjs build",
        "test:themes": "node --test tests/ThemeVite.test.mjs",
        "test:assets": "node --test tests/PublicAssets.test.mjs tests/NoJQuery.test.mjs tests/Native*.test.mjs",
        "dev:public": "node scripts/public-assets.mjs --watch",
        "watch:public": "node scripts/public-assets.mjs --watch",
        "build:public": "npm run build:themes && npm run build:assets",
        "build:assets": "node scripts/public-assets.mjs",
        "typecheck:admin": "tsc --noEmit -p tsconfig.json",
        "lint:admin": "eslint resources/js/admin.tsx resources/js/member.tsx \"platform/plugins/member/resources/js/account/**/*.{ts,tsx}\" \"platform/**/resources/js/admin/**/*.{ts,tsx}\" --max-warnings=0 && prettier --check resources/js/admin.tsx resources/js/member.tsx \"platform/plugins/member/resources/js/account/**/*.{ts,tsx}\" \"platform/**/resources/js/admin/**/*.{ts,tsx,mjs,json}\" \"platform/**/resources/css/admin.css\" vite.config.ts tsconfig.json components.json",
        "test:admin": "node --test --test-reporter=spec \"platform/**/resources/js/admin/**/*.test.mjs\""
    },
    "devDependencies": {
        "@shufo/prettier-plugin-blade": "^1.14.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/parser": "8.46.1",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "css-select": "^7.0.0",
        "dom-serializer": "^3.1.1",
        "domhandler": "^6.0.1",
        "eslint": "9.39.1",
        "eslint-plugin-react-hooks": "7.0.1",
        "glob": "^13.0",
        "htmlparser2": "^12.0.0",
        "laravel-vite-plugin": "^2.1.0",
        "postcss": "^8.4.49",
        "prettier": "^3.4.1",
        "rtlcss": "^4.3.0",
        "sass": "^1.82.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vite": "^7.3.7"
    },
    "dependencies": {
        "@inertiajs/react": "^3.9.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-radio-group": "^1.5.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@tanstack/react-table": "^8.21.3",
        "@tiptap/core": "^3.32.0",
        "@tiptap/extension-image": "^3.32.0",
        "@tiptap/extension-table": "3.32.0",
        "@tiptap/extension-text-align": "3.32.0",
        "@tiptap/extension-text-style": "3.32.0",
        "@tiptap/extension-youtube": "3.32.0",
        "@tiptap/pm": "^3.32.0",
        "@tiptap/react": "^3.32.0",
        "@tiptap/starter-kit": "^3.32.0",
        "axios": "^1.7.8",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cropperjs": "^1.6.2",
        "epic-spinners": "^2.0.0",
        "lodash": "^4.17.21",
        "lucide-react": "^1.57.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sanitize-html": "^2.13.1",
        "tailwind-merge": "^3.7.0",
        "tiny-emitter": "^2.1.0",
        "vue": "^3.3.4"
    },
    "name": "kern-cms"
}

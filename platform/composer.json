{
    "name": "binhtq1/kern-core",
    "type": "library",
    "description": "Upgradeable Kern CMS runtime",
    "license": "MIT",
    "homepage": "https://github.com/binhtq1/kern-core",
    "bin": [
        "bin/migrate-to-core.php"
    ],
    "require": {
        "php": "^8.4",
        "inertiajs/inertia-laravel": "^3.0",
        "ext-zip": "*",
        "ext-gd": "*",
        "barryvdh/laravel-dompdf": "^3.0",
        "intervention/image": "^3.4",
        "maennchen/zipstream-php": "3.1.*",
        "yajra/laravel-datatables-buttons": "^13.0",
        "yajra/laravel-datatables-oracle": "^13.0",
        "mews/purifier": "^3.3",
        "maatwebsite/excel": "^3.1",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/postmark-mailer": "^7.4 || ^8.0",
        "symfony/mailgun-mailer": "^7.4 || ^8.0",
        "twig/twig": "^3.14",
        "league/flysystem-aws-s3-v3": "^3.0",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.3",
        "knuckleswtf/scribe": "^5.0",
        "spatie/simple-excel": "^3.6"
    },
    "replace": {
        "kern/platform": "1.0.0",
        "kern/api": "1.0.0",
        "kern/assets": "1.0.0",
        "kern/data-synchronize": "1.0.0",
        "kern/form-builder": "1.0.0",
        "kern/get-started": "1.0.0",
        "kern/installer": "1.0.0",
        "kern/menu": "1.0.0",
        "kern/optimize": "1.0.0",
        "kern/page": "1.0.0",
        "kern/plugin-management": "1.0.0",
        "kern/revision": "1.0.0",
        "kern/seo-helper": "1.0.0",
        "kern/shortcode": "1.0.0",
        "kern/sitemap": "1.0.0",
        "kern/slug": "1.0.0",
        "kern/theme": "1.0.0",
        "kern/widget": "1.0.0"
    },
    "autoload": {
        "psr-4": {
            "Kern\\Support\\": "core/support/src",
            "Kern\\ACL\\": "core/acl/src",
            "Kern\\Base\\": "core/base/src",
            "Kern\\Base\\Tests\\": "core/base/tests",
            "Kern\\Dashboard\\": "core/dashboard/src",
            "Kern\\Media\\": "core/media/src",
            "Kern\\Setting\\": "core/setting/src",
            "Kern\\Table\\": "core/table/src",
            "Kern\\JsValidation\\": "core/js-validation/src",
            "Kern\\Chart\\": "core/chart/src",
            "Kern\\Icon\\": "core/icon/src",
            "Kern\\Api\\": "packages/api/src",
            "Kern\\Assets\\": "packages/assets/src",
            "Kern\\DataSynchronize\\": "packages/data-synchronize/src/",
            "Kris\\LaravelFormBuilder\\": "packages/form-builder/src/",
            "Kern\\GetStarted\\": "packages/get-started/src",
            "Kern\\Installer\\": "packages/installer/src",
            "Kern\\Menu\\": "packages/menu/src",
            "Kern\\Optimize\\": "packages/optimize/src",
            "Kern\\Page\\": "packages/page/src",
            "Kern\\PluginManagement\\": "packages/plugin-management/src",
            "Kern\\Revision\\": "packages/revision/src",
            "Kern\\SeoHelper\\": "packages/seo-helper/src",
            "Kern\\Shortcode\\": "packages/shortcode/src",
            "Kern\\Sitemap\\": "packages/sitemap/src",
            "Kern\\Slug\\": "packages/slug/src",
            "Kern\\Theme\\": "packages/theme/src",
            "Kern\\Widget\\": "packages/widget/src"
        },
        "files": [
            "packages/form-builder/helpers/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kern\\Base\\Providers\\BaseServiceProvider",
                "Kern\\Base\\Providers\\CommandServiceProvider",
                "Kern\\Base\\Providers\\EventServiceProvider",
                "Kern\\Base\\Providers\\ComposerServiceProvider",
                "Kern\\Base\\Providers\\MailConfigServiceProvider",
                "Kern\\Base\\Providers\\FormServiceProvider",
                "Kern\\Support\\Providers\\SupportServiceProvider",
                "Kern\\Table\\Providers\\TableServiceProvider",
                "Kern\\ACL\\Providers\\AclServiceProvider",
                "Kern\\Dashboard\\Providers\\DashboardServiceProvider",
                "Kern\\Media\\Providers\\MediaServiceProvider",
                "Kern\\JsValidation\\Providers\\JsValidationServiceProvider",
                "Kern\\Chart\\Providers\\ChartServiceProvider",
                "Kern\\Icon\\Providers\\IconServiceProvider",
                "Kern\\Api\\Providers\\ApiServiceProvider",
                "Kern\\Assets\\Providers\\AssetsServiceProvider",
                "Kern\\DataSynchronize\\Providers\\DataSynchronizeServiceProvider",
                "Kris\\LaravelFormBuilder\\FormBuilderServiceProvider",
                "Kern\\GetStarted\\Providers\\GetStartedServiceProvider",
                "Kern\\Installer\\Providers\\InstallerServiceProvider",
                "Kern\\Menu\\Providers\\MenuServiceProvider",
                "Kern\\Optimize\\Providers\\OptimizeServiceProvider",
                "Kern\\Page\\Providers\\PageServiceProvider",
                "Kern\\PluginManagement\\Providers\\PluginManagementServiceProvider",
                "Kern\\Revision\\Providers\\RevisionServiceProvider",
                "Kern\\SeoHelper\\Providers\\SeoHelperServiceProvider",
                "Kern\\Shortcode\\Providers\\ShortcodeServiceProvider",
                "Kern\\Sitemap\\Providers\\SitemapServiceProvider",
                "Kern\\Slug\\Providers\\SlugServiceProvider",
                "Kern\\Theme\\Providers\\ThemeServiceProvider",
                "Kern\\Theme\\Providers\\RouteServiceProvider",
                "Kern\\Widget\\Providers\\WidgetServiceProvider"
            ],
            "aliases": {
                "Action": "Kern\\Base\\Facades\\Action",
                "AdminAppearance": "Kern\\Base\\Facades\\AdminAppearance",
                "AdminHelper": "Kern\\Base\\Facades\\AdminHelper",
                "Assets": "Kern\\Base\\Facades\\Assets",
                "BaseHelper": "Kern\\Base\\Facades\\BaseHelper",
                "DashboardMenu": "Kern\\Base\\Facades\\DashboardMenu",
                "CoreIcon": "Kern\\Icon\\Facades\\Icon",
                "EmailHandler": "Kern\\Base\\Facades\\EmailHandler",
                "Filter": "Kern\\Base\\Facades\\Filter",
                "Form": "Kern\\Base\\Facades\\Form",
                "Html": "Kern\\Base\\Facades\\Html",
                "JsValidator": "Kern\\JsValidation\\Facades\\JsValidator",
                "MacroableModels": "Kern\\Base\\Facades\\MacroableModels",
                "MetaBox": "Kern\\Base\\Facades\\MetaBox",
                "PageTitle": "Kern\\Base\\Facades\\PageTitle",
                "PanelSectionManager": "Kern\\Base\\Facades\\PanelSectionManager",
                "RvMedia": "Kern\\Media\\Facades\\RvMedia",
                "Setting": "Kern\\Setting\\Facades\\Setting",
                "ApiHelper": "Kern\\Api\\Facades\\ApiHelper",
                "FormBuilder": "Kris\\LaravelFormBuilder\\Facades\\FormBuilder",
                "Menu": "Kern\\Menu\\Facades\\Menu",
                "OptimizerHelper": "Kern\\Optimize\\Facades\\OptimizerHelper",
                "SeoHelper": "Kern\\SeoHelper\\Facades\\SeoHelper",
                "Shortcode": "Kern\\Shortcode\\Facades\\Shortcode",
                "SlugHelper": "Kern\\Slug\\Facades\\SlugHelper",
                "Theme": "Kern\\Theme\\Facades\\Theme",
                "ThemeOption": "Kern\\Theme\\Facades\\ThemeOption",
                "ThemeManager": "Kern\\Theme\\Facades\\Manager",
                "AdminBar": "Kern\\Theme\\Facades\\AdminBar",
                "SiteMapManager": "Kern\\Theme\\Facades\\SiteMapManager",
                "Widget": "Kern\\Widget\\Facades\\Widget",
                "WidgetGroup": "Kern\\Widget\\Facades\\WidgetGroup"
            }
        }
    }
}

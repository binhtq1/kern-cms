{
    "name": "kern/assets",
    "description": "Asset management for Kern CMS",
    "homepage": "https://github.com/binhtq1/kern-cms",
    "license": "MIT",
    "keywords": [
        "kern",
        "kern cms",
        "kern platform",
        "kern assets"
    ],
    "authors": [
        {
            "name": "Binh Tran",
            "email": "quocbinhkrb@gmail.com",
            "homepage": "https://github.com/binhtq1",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/binhtq1/kern-cms/issues",
        "source": "https://github.com/binhtq1/kern-cms/tree/main/platform/packages/assets",
        "email": "quocbinhkrb@gmail.com"
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^6.1|^7.0|^8.0|^9.0|^10.0|^11.0",
        "mockery/mockery": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Kern\\Assets\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kern\\Assets\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kern\\Assets\\Providers\\AssetsServiceProvider"
            ],
            "aliases": {
                "Assets": "Kern\\Assets\\Facades\\AssetsFacade"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "version": "1.0.0"
}

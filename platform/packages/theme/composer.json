        }
    },
    "require": {
        "kern/platform": "^1.0",
        "kern/sitemap": "^1.0",
        "kern/widget": "^1.0",
        "kern/slug": "^1.0",
        "kern/seo-helper": "^1.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kern\\Theme\\Providers\\ThemeServiceProvider",
                "Kern\\Theme\\Providers\\RouteServiceProvider"
            ],
            "aliases": {
                "Theme": "Kern\\Theme\\Facades\\Theme",
                "ThemeOption": "Kern\\Theme\\Facades\\ThemeOption",
                "ThemeManager": "Kern\\Theme\\Facades\\Manager",
                "AdminBar": "Kern\\Theme\\Facades\\AdminBar",
                "SiteMapManager": "Kern\\Theme\\Facades\\SiteMapManager"
            }
        }
    },
    "version": "1.0.0"

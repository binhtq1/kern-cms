{
    "name": "kern/api",
    "description": "API package for Kern CMS",
    "homepage": "https://github.com/binhtq1/kern-cms",
    "type": "package",
    "license": "MIT",
    "keywords": [
        "kern",
        "kern cms",
        "kern platform",
        "kern api"
    ],
    "authors": [
        {
            "name": "Binh Tran",
            "email": "quocbinhkrb@gmail.com",
            "homepage": "https://github.com/binhtq1",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/binhtq1/kern-cms/issues",
        "source": "https://github.com/binhtq1/kern-cms/tree/main/platform/packages/api",
        "email": "quocbinhkrb@gmail.com"
    },
    "autoload": {
        "psr-4": {
            "Kern\\Api\\": "src"
        }
    },
    "require": {
        "knuckleswtf/scribe": "^5.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kern\\Api\\Providers\\ApiServiceProvider"
            ],
            "aliases": {
                "ApiHelper": "Kern\\Api\\Facades\\ApiHelper"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "version": "1.0.0"
}
